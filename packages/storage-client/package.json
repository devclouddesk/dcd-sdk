{
  "name": "@dcd-sdk/storage-client",
  "version": "1.0.0",
  "description": "Official Node.js & TypeScript client SDK for DevCloudDesk Storage Engine",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devclouddesk/dcd-sdk.git",
    "directory": "packages/storage-client"
  },
  "homepage": "https://devclouddesk.com",
  "license": "MIT"
}
